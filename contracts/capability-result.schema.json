{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bdf1992/ide/contracts/capability-result.schema.json",
  "title": "CAPABILITY_RESULT/1",
  "description": "The bounded result of attempting one capability request. It reports outcome; it does not retroactively grant authority.",
  "type": "object",
  "required": ["protocol", "request_id", "capability", "status"],
  "properties": {
    "protocol": {"const": "CAPABILITY_RESULT/1"},
    "request_id": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "refused", "failed", "unsupported"]},
    "output": {},
    "error": {
      "type": "object",
      "properties": {
        "kind": {"type": "string"},
        "message": {"type": "string"}
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "workspace_revision_before": {"type": ["integer", "string"]},
    "workspace_revision_after": {"type": ["integer", "string"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}