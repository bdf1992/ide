{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bdf1992/ide/contracts/evidence-receipt.schema.json",
  "title": "EVIDENCE_RECEIPT/1",
  "description": "Computed evidence about a bounded subject. A receipt records checks and standing actually earned; prose cannot strengthen it.",
  "type": "object",
  "required": ["protocol", "receipt_id", "subject", "checks", "standing"],
  "properties": {
    "protocol": {"const": "EVIDENCE_RECEIPT/1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["workspace-patch", "capability", "semantic-program", "projection", "execution", "experiment"]},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "kernel_version": {"type": "string"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "refused", "unsupported", "agreed-failure"]},
          "detail": {"type": "string"},
          "evidence_ref": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "standing": {
      "type": "object",
      "required": ["scheme", "value"],
      "properties": {
        "scheme": {"enum": ["semantic-s0-s4", "none", "other"]},
        "value": {"type": "string"}
      },
      "additionalProperties": false
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}