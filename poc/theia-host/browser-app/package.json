{
  "private": true,
  "name": "browser-app",
  "version": "0.0.0",
  "license": "MIT",
  "applicationName": "Open Chat IDE host spike",
  "dependencies": {
    "@poc/ide-seam": "0.0.0",
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/messages": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/navigator": "1.75.0",
    "@theia/preferences": "1.75.0",
    "@theia/process": "1.75.0",
    "@theia/task": "1.75.0",
    "@theia/terminal": "1.75.0",
    "@theia/workspace": "1.75.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@theia/cli": "1.75.0"
  },
  "theia": {
    "target": "browser",
    "backend": {
      "config": {
        "startupTimeout": -1
      }
    }
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {},
  "scripts": {
    "prepare": "theia build --mode development",
    "bundle": "theia build --mode production",
    "start": "theia start --hostname=0.0.0.0 --port=3000",
    "watch": "theia build --watch --mode development"
  }
}
