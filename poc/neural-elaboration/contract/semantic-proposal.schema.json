{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bdf1992/ide/poc/neural-elaboration/contract/semantic-proposal.schema.json",
  "title": "SEMANTIC_PROPOSAL/1",
  "type": "object",
  "required": ["protocol", "kernel_version", "disposition"],
  "properties": {
    "protocol": {"const": "SEMANTIC_PROPOSAL/1"},
    "kernel_version": {"const": "0.1"},
    "disposition": {"enum": ["propose", "refuse"]},
    "candidate_ir": {"type": "object"},
    "typed_structure": {
      "type": "object",
      "required": ["version", "data_refs", "tokens", "token_state", "signals"],
      "properties": {
        "version": {"const": "TSR/0.1"},
        "data_refs": {"type": "array"},
        "tokens": {"type": "array"},
        "token_state": {"type": "array"},
        "signals": {"type": "array"}
      },
      "additionalProperties": false
    },
    "refusal": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": {"type": "string"},
        "detail": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "propose"}}},
      "then": {"required": ["candidate_ir", "typed_structure"]}
    },
    {
      "if": {"properties": {"disposition": {"const": "refuse"}}},
      "then": {"required": ["refusal"]}
    }
  ],
  "additionalProperties": false
}

